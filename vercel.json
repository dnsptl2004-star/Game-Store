{
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/build",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://indian-garment-1.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://indian-garment-1.onrender.com/uploads/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
