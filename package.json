{
    "name": "gamevault-store",
    "private": true,
    "scripts": {
        "dev": "concurrently \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
        "start": "node index.js",
        "build": "npm install --prefix client && npm run build --prefix client",
        "postinstall": "npm install --prefix client",
        "seed:admin": "node server/seedAdmin.js",
        "seed:products": "node server/seedProducts.js"
    },
    "devDependencies": {
        "concurrently": "^9.0.0"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1175.0",
        "@aws-sdk/lib-storage": "^3.1175.0",
        "@aws-sdk/s3-request-presigner": "^3.1175.0",
        "archiver": "^8.0.0",
        "bcrypt": "^5.1.1",
        "client-zip": "^2.5.1",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "dotenv": "^17.4.0",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "mime-types": "^3.0.2",
        "mongodb": "^7.1.1",
        "mongoose": "^9.3.3",
        "multer": "^2.1.1",
        "unzipper": "^0.12.5",
        "uuid": "^14.0.3"
    },
    "type": "module"
}
